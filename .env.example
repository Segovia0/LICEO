# Puerto del servidor
PORT=3000

# Secreto para firmar los tokens JWT.
# Obligatorio, mínimo 32 caracteres. Genérelo con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES

# Usuario administrador inicial (solo se crea si la tabla usuarios está vacía)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin1234

# Opcional: ruta alternativa de la base SQLite (pruebas o restauración)
# DB_PATH=./liceo.sqlite

# Opcional: orígenes permitidos separados por coma. Ejemplo:
# CORS_ORIGIN=http://localhost:3000,https://liceo.ejemplo.com
CORS_ORIGIN=

# Poner en true si está detrás de Nginx/Caddy
TRUST_PROXY=false

# Duración de la sesión y del token temporal de cambio de contraseña
JWT_EXPIRES_IN=8h
JWT_PASSWORD_CHANGE_EXPIRES_IN=15m

# Credenciales de Google Drive (OAuth2) - opcionales, solo para respaldos en la nube
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secreto
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=tu_refresh_token
